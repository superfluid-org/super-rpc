# Number of cluster workers (default: number of CPU cores)
WORKERS=2

# Metrics server port
METRICS_PORT=4510

# Max concurrent requests per worker before returning 503
MAX_CONCURRENT=500

# Max HTTP sockets per upstream host
MAX_SOCKETS=50

# Cache TTL in seconds (immutable methods like eth_chainId ignore this)
CACHE_MAX_AGE=10

# Max entries in the in-memory LRU cache per worker
CACHE_MAX_ENTRIES=10000
